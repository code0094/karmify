# Telegram (optional — only the bot entrypoint `python -m src.main` needs it;
# the sidecar runs without Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must match the redirect URI registered in the Spotify app exactly.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8765/auth/spotify/callback
# Optional: the supported way to connect an account is "Log in with Spotify"
# in the app, which stores tokens in the database. Fill these only to keep an
# account that was authorized before that button existed.
KARMA_SPOTIFY_REFRESH_TOKEN=
STRESS303_SPOTIFY_REFRESH_TOKEN=

# Discogs
DISCOGS_USER_TOKEN=

# Last.fm
LASTFM_API_KEY=
LASTFM_API_SECRET=

# Database
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/aux_dj_bot

# App
# POLL_SCHEDULE is unused in manual (thick-client) mode — likes are fetched via /fetch.
POLL_SCHEDULE=08:00,20:00
LOG_LEVEL=INFO

# Track downloading (zotify) — audio is fetched on demand via the ⬇️ button.
DOWNLOAD_DIR=downloads
DOWNLOAD_FORMAT=mp3
# normal | high | very_high  (very_high = 320kbps, requires Spotify Premium)
DOWNLOAD_QUALITY=very_high
DOWNLOAD_CONCURRENCY=1
DOWNLOAD_TIMEOUT_SEC=300
# Path to a zotify credentials.json generated once with a BURNER account
# (never the working karma/stress303 accounts — ToS/ban risk).
ZOTIFY_CREDENTIALS_PATH=
DOWNLOAD_SEND_TO_CHAT=true
TELEGRAM_UPLOAD_LIMIT_MB=50

# Sidecar HTTP API (consumed by the Electron desktop app).
# Keep it on 127.0.0.1 and reach it from the desktop via an SSH tunnel.
SIDECAR_HOST=127.0.0.1
SIDECAR_PORT=8765
# Host header values the sidecar answers to. Add the public hostname when it
# runs behind a reverse proxy (the bind address is always allowed).
SIDECAR_ALLOWED_HOSTS=127.0.0.1,localhost
# Browser origins allowed when no token is set (Vite dev server by default).
SIDECAR_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Shared secret for the X-Aux-Token header. The Electron app mints one per run
# automatically; set it here only when running the sidecar standalone (e.g. on
# the VPS behind an SSH tunnel). Without it, the packaged renderer is trusted by
# its 'null' origin — which any sandboxed iframe on any website can also send.
SIDECAR_AUTH_TOKEN=

# Local DJ library — watched folder imported by Rekordbox/Serato.
LIBRARY_DIR=library

# Soulseek source via the slskd daemon (optional — leave blank to disable).
SLSKD_URL=
SLSKD_API_KEY=
SLSKD_DOWNLOADS_DIR=

# Bandcamp source (anonymous name-your-price $0 -> email -> FLAC).
# Mailbox that receives Bandcamp download links (Gmail + app password recommended).
BANDCAMP_MAIL_IMAP_HOST=imap.gmail.com
BANDCAMP_MAIL_ADDRESS=
BANDCAMP_MAIL_PASSWORD=
# Optional CapSolver key for the Bandcamp CAPTCHA; blank = manual click fallback.
CAPTCHA_API_KEY=
